/* 进山咖啡：黑底金色，跟 logo 一致 */
page {
  --bg: #0b0b0b;
  --card: #171615;
  --card-2: #211f1c;
  --line: #2c2925;
  --gold: #d6b25e;
  --gold-soft: rgba(214, 178, 94, 0.14);
  --text: #f2ecdf;
  --text-2: #a39b8b;
  --text-3: #6f685c;
  --danger: #e0715c;
  --ok: #7fbf8a;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

view, text, input, textarea, button, scroll-view {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 12rpx 4rpx 16rpx;
}

.gold { color: var(--gold); }
.muted { color: var(--text-2); }
.faint { color: var(--text-3); }
.danger { color: var(--danger); }
.ok { color: var(--ok); }

.price {
  color: var(--gold);
  font-weight: 600;
}
.price::before {
  content: "¥";
  font-size: 0.75em;
  margin-right: 2rpx;
}
.price.big { font-size: 40rpx; }

.btn-gold,
.btn-ghost,
.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-gold { background: var(--gold); color: #1a1408; }
.btn-ghost { border: 1rpx solid var(--gold); color: var(--gold); }
.btn-danger { border: 1rpx solid var(--danger); color: var(--danger); }
.btn-block { display: flex; width: 100%; }
.btn-small { height: 60rpx; padding: 0 28rpx; font-size: 26rpx; border-radius: 30rpx; }
.btn-gold.disabled, .btn-ghost.disabled { opacity: 0.4; }
.btn-hover { opacity: 0.75; }

/* 小状态标签（可借 2 本、已收款…）：固定高度 + line-height 居中，不换行 */
.tag {
  display: inline-block;
  height: 36rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  vertical-align: middle;
  background: var(--card-2);
  color: var(--text-2);
}
.tag.gold { background: var(--gold-soft); color: var(--gold); }
.tag.danger { background: rgba(224, 113, 92, 0.15); color: var(--danger); }
.tag.ok { background: rgba(127, 191, 138, 0.15); color: var(--ok); }

.empty {
  text-align: center;
  color: var(--text-3);
  padding: 80rpx 0;
}

.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-1 { flex: 1; min-width: 0; }

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child { border-bottom: none; }
.cell-arrow::after {
  content: "›";
  color: var(--text-3);
  font-size: 36rpx;
  margin-left: 12rpx;
}

/* 底部弹层 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-close { font-size: 44rpx; line-height: 1; color: var(--text-3); padding: 8rpx 8rpx 8rpx 32rpx; }

/* 数量加减 */
.stepper {
  display: flex;
  align-items: center;
}
.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border: 1rpx solid var(--gold);
  color: var(--gold);
}
.stepper-btn.plus { background: var(--gold); color: #1a1408; }
.stepper-num { min-width: 64rpx; text-align: center; }

/* 表单 */
.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.field:last-child { border-bottom: none; }
.field-label {
  width: 160rpx;
  padding-right: 16rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  color: var(--text);
  font-size: 28rpx;
}
.placeholder { color: var(--text-3); }

.chips {
  display: flex;
  flex-wrap: wrap;
}
/* 选项标签。高度写死、靠 line-height 居中（UI 规范 2.2）：不要用上下 padding 撑高度，
   放进 flex 容器时会被拉高，文字就贴在上半截 */
.chip {
  height: 64rpx;
  line-height: 62rpx;
  padding: 0 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--card-2);
  color: var(--text);
  font-size: 26rpx;
  white-space: nowrap;
  text-align: center;
}
.chip.on {
  border-color: var(--gold);
  background: var(--gold-soft);
  color: var(--gold);
}
.chip.mini {
  height: 52rpx;
  line-height: 50rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

/* 横向滑动的分类栏（UI 规范 2.3），写法固定：
   <view class="chip-bar {{fade ? 'fade' : ''}}">
     <scroll-view class="chip-scroll" scroll-x enhanced show-scrollbar="{{false}}" bindscroll="onBarScroll">
       <view class="chip-track"><view class="chip">…</view></view>
     </scroll-view>
   </view>
   · scroll-view 不加 enable-flex（真机上会把胶囊撑高、文字贴顶，2026-11 书架页就是这样）
   · 放在 .page 里时加 bleed，滑动区通到屏幕两边，不会在页边距处被切一刀
   · fade 由 utils/chip-bar.js 算：内容超出屏幕且没滑到最右时，右边渐隐提示还能滑 */
.chip-bar {
  position: relative;
}
.chip-bar.bleed {
  margin-left: -24rpx;
  margin-right: -24rpx;
}
.chip-scroll {
  width: 100%;
  height: 88rpx;
  white-space: nowrap;
}
.chip-track {
  display: inline-flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}
.chip-track .chip {
  flex-shrink: 0;
  height: 60rpx;
  line-height: 58rpx;
  margin: 0 16rpx 0 0;
  border-radius: 30rpx;
}
.chip-track .chip:last-child {
  margin-right: 0;
}
.chip-bar.fade::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 80rpx;
  background: linear-gradient(to right, rgba(11, 11, 11, 0), var(--bg));
  pointer-events: none;
}

.safe-bottom { height: calc(140rpx + env(safe-area-inset-bottom)); }
